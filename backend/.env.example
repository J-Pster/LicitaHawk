# ---- Ambiente local (Fase 1) ----
NODE_ENV=development
PORT=3000
# Regiao fake aceita pelo SDK quando apontando pro DynamoDB Local; em producao usar a regiao real da conta AWS.
AWS_REGION=us-east-1
# Endpoint do DynamoDB Local. Deixe vazio/ausente em producao para o SDK usar o endpoint real da AWS.
DYNAMODB_ENDPOINT=http://localhost:8000

# Opcional -- numero de falhas consecutivas de entrega de webhook ate o circuit breaker
# desativar o filtro (ver src/webhook/circuit-breaker.ts). Default no codigo: 5.
WEBHOOK_MAX_CONSECUTIVE_FAILURES=

# ---- Cognito (auth do frontend, monorepo) ----
# User Pool real criado via aws-cli (perfil LicitaHawk), excecao autorizada explicitamente
# pelo usuario a "100% local ate a Fase 7" -- ver PLAN.md. Nao ha equivalente local/emulado.
COGNITO_USER_POOL_ID=us-east-1_VtOEPrPpu
COGNITO_CLIENT_ID=31jjvqf9e7g0ksglgnv5mt3utk
COGNITO_REGION=us-east-1

# Origem do frontend Angular liberada no CORS (src/server.ts). Default: dev local.
FRONTEND_ORIGIN=http://localhost:4200

# ---- Asaas (billing) ----
ASAAS_API_KEY_PROD=
# Sandbox (sandbox.asaas.com) -- pra testar checkout sem tocar producao. ASAAS_ENV=sandbox usa
# essa chave; ASAAS_ENV=producao (exato) usa ASAAS_API_KEY_PROD. Default (ausente/qualquer coisa
# diferente de "producao"): sandbox.
ASAAS_API_KEY_SANDBOX=
ASAAS_ENV=sandbox
# Segredo estatico do webhook do Asaas (header "asaas-access-token"). Fail-closed:
# se vazio, POST /webhooks/asaas SEMPRE retorna 403 (ver src/billing/security.ts).
ASAAS_WEBHOOK_TOKEN=

# ---- Focus NFe (compartilhado com pster-finance, mesmo CNPJ emissor) ----
FOCUS_TOKEN=
FOCUS_TOKEN_HOMOLOGACAO=
FOCUS_ENV=homologacao
FOCUS_WEBHOOK_TOKEN_PRODUCAO=
FOCUS_WEBHOOK_TOKEN_HOMOLOGACAO=
FOCUS_WEBHOOK_HEADER=
FOCUS_CALLBACK_URL=

# ---- Prestador (mesmo CNPJ emissor do pster-finance) ----
PRESTADOR_CNPJ=
PRESTADOR_INSCRICAO_MUNICIPAL=
PRESTADOR_CODIGO_MUNICIPIO=
PRESTADOR_OPTANTE_SIMPLES=
# Opcionais -- defaults no codigo (src/billing/nfse-payload.ts) sao placeholders
# (1.05 / ISS 2%) para SaaS de API, PENDENTES de confirmacao com o contador antes
# de qualquer emissao real em producao.
PRESTADOR_ITEM_LISTA_SERVICO=
PRESTADOR_ALIQUOTA_ISS=
