{
  "name": "licitahawk",
  "version": "0.1.0",
  "private": true,
  "description": "API REST + servidor MCP sobre dados oficiais de licitacoes do PNCP",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "ingest": "tsx src/tenders/run-ingestion.ts",
    "reconcile": "tsx src/tenders/run-reconciliation.ts",
    "create-test-key": "tsx scripts/create-test-api-key.ts",
    "send-test-email": "tsx scripts/send-test-email.ts",
    "backfill-uf-modalidade": "tsx scripts/backfill-uf-modalidade.ts",
    "test-mcp-client": "tsx scripts/test-mcp-client.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "aws-jwt-verify": "^5.2.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "js-yaml": "^5.4.1",
    "node-cron": "^3.0.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
